<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dog_ia">
  <material name="blue"><color rgba="0.08 0.35 0.7 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="silver"><color rgba="0.7 0.75 0.8 1"/></material>
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial><mass value="${m}"/><inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/></inertial>
  </xacro:macro>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.22"/></joint>
  <link name="base_link">
    <visual><geometry><box size="0.5 0.34 0.16"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="0.5 0.34 0.16"/></geometry></collision>
    <xacro:box_inertia m="8" x="0.5" y="0.34" z="0.16"/>
  </link>
  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <xacro:macro name="wheel" params="side sign">
    <link name="${side}_wheel_link">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.1" length="0.045"/></geometry><material name="black"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.1" length="0.045"/></geometry></collision>
      <inertial><mass value="0.5"/><inertia ixx="0.001334375" ixy="0" ixz="0" iyy="0.0025" iyz="0" izz="0.001334375"/></inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0.08 ${sign*0.195} -0.12"/><axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0"/>
    </joint>
    <gazebo reference="${side}_wheel_link"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel side="left" sign="1"/>
  <xacro:wheel side="right" sign="-1"/>
  <!-- A low-friction spherical caster approximates a passive ball wheel. -->
  <link name="caster_link">
    <visual><geometry><sphere radius="0.04"/></geometry><material name="silver"/></visual>
    <collision><geometry><sphere radius="0.04"/></geometry></collision>
    <inertial><mass value="0.15"/><inertia ixx="0.000096" ixy="0" ixz="0" iyy="0.000096" iyz="0" izz="0.000096"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_link"/><origin xyz="-0.19 0 -0.18"/></joint>
  <gazebo reference="caster_link"><mu1>0.001</mu1><mu2>0.001</mu2><material>Gazebo/Grey</material></gazebo>
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.055" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.055" length="0.04"/></geometry></collision>
    <xacro:box_inertia m="0.15" x="0.11" y="0.11" z="0.04"/>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.15 0 0.12"/></joint>
  <link name="mast_link">
    <visual><geometry><box size="0.035 0.035 0.35"/></geometry><material name="silver"/></visual>
    <!-- Visual-only mast collision: avoids self-occlusion in this simplified ray model. -->
    <xacro:box_inertia m="0.2" x="0.035" y="0.035" z="0.35"/>
  </link>
  <joint name="mast_joint" type="fixed"><parent link="base_link"/><child link="mast_link"/><origin xyz="-0.04 0 0.255"/></joint>
  <link name="camera_link">
    <visual><geometry><box size="0.055 0.12 0.05"/></geometry><material name="black"/></visual>
    <collision><geometry><box size="0.055 0.12 0.05"/></geometry></collision>
    <xacro:box_inertia m="0.15" x="0.055" y="0.12" z="0.05"/>
  </link>
  <!-- Negative pitch points the camera upward by about 11.5 degrees. -->
  <joint name="camera_joint" type="fixed"><parent link="mast_link"/><child link="camera_link"/><origin xyz="0.025 0 0.2" rpy="0 -0.2 0"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
      <range><min>0.12</min><max>10</max><resolution>0.01</resolution></range></ray>
      <plugin name="lidar_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="depth">
      <always_on>true</always_on><update_rate>10</update_rate>
      <camera><horizontal_fov>1.2</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>8</far></clip></camera>
      <plugin name="camera_ros" filename="libgazebo_ros_camera.so">
        <ros><namespace>/camera</namespace>
          <remapping>rgbd/image_raw:=/camera/image_raw</remapping>
          <remapping>rgbd/camera_info:=/camera/camera_info</remapping>
          <remapping>rgbd/depth/image_raw:=/camera/depth/image_raw</remapping>
          <remapping>rgbd/depth/camera_info:=/camera/depth/camera_info</remapping>
          <remapping>rgbd/points:=/camera/points</remapping>
        </ros>
        <camera_name>rgbd</camera_name><frame_name>camera_optical_frame</frame_name>
        <min_depth>0.1</min_depth><max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin name="drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=/cmd_vel_safe</remapping></ros>
      <update_rate>30</update_rate><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.39</wheel_separation><wheel_diameter>0.2</wheel_diameter>
      <max_wheel_torque>15</max_wheel_torque><max_wheel_acceleration>1.5</max_wheel_acceleration>
      <command_topic>cmd_vel_safe</command_topic><odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
    <plugin name="wheel_states" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>30</update_rate><joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
